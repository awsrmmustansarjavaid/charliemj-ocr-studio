# =============================================================================
# .gitignore - files and folders Git should NOT track
# Project: Charlie MJ OCR & Language Studio
# =============================================================================

# --- Python bytecode & caches ------------------------------------------------
# Auto-generated by Python when running the app or tests; never commit.
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/

# --- Virtual environments ----------------------------------------------------
# Local Python environments are machine-specific and large.
venv/
.venv/
env/

# --- PyInstaller build output ------------------------------------------------
# build/ and dist/ hold generated files and the final .exe folder.
# The finished app is distributed through GitHub Actions artifacts instead.
build/
dist/
*.spec

# --- Bundled Tesseract ---------------------------------------------------------
# The Tesseract binaries (~100 MB) are downloaded by CI or copied manually.
# Keeping them out of Git keeps the repository small.
/tesseract/
*.traineddata

# --- User data ------------------------------------------------------------------
# config.json holds the user's personal settings (language, model, paths).
config.json
.env

# --- Generated exports ---------------------------------------------------------
# Notes exported by the user while testing.
exports/

# --- Editor / IDE files --------------------------------------------------------
.vscode/
.idea/
*.swp

# --- Operating-system junk -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ----------------------------------------------------------------------
*.log
