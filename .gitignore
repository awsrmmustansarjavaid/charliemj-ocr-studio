# =============================================================================
# .gitignore - files and folders Git should NOT track
# Project: Charlie MJ OCR & Language Studio
# =============================================================================

# --- Python bytecode & caches ------------------------------------------------
# Auto-generated by Python when running the app; never commit.
__pycache__/
*.py[cod]
*.pyo

# --- Virtual environments ----------------------------------------------------
# Local Python environments are machine-specific and large.
venv/
.venv/
env/

# --- PyInstaller build output ------------------------------------------------
# build/ and dist/ hold generated files and the final .exe folder.
# The finished app is distributed via GitHub Actions artifacts/releases instead.
build/
dist/
*.spec

# --- Bundled Tesseract ---------------------------------------------------------
# The Tesseract binaries (~100 MB) are downloaded by CI or copied manually.
# Keeping them out of Git keeps the repository small.
/tesseract/

# --- User data & secrets -------------------------------------------------------
# config.json stores the user's Gemini API KEY. NEVER commit it.
config.json
*.key
.env

# --- Generated exports ---------------------------------------------------------
# Notes exported by the user while testing.
exports/
*.traineddata

# --- Editor / IDE files --------------------------------------------------------
.vscode/
.idea/
*.swp

# --- Operating-system junk -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ----------------------------------------------------------------------
*.log
